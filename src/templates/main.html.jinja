<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/static/favicon.ico" type="image/x-icon">
    <title>RCSB PDB Embedding Search</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
        }
        form > div > div, form > div > div > div {
            display:inline-block;
        }
        .form_switch:hover {
            color: #999;
            cursor: pointer;
        }

        a {
            text-decoration: none;
            color: cornflowerblue;
            cursor: pointer;
        }
        a:visited {
            color: cornflowerblue;
        }
        a:hover {
            color: lightskyblue;
        }

    </style>
</head>
<body>
{% block content %}
{% endblock %}
</body>
</html>